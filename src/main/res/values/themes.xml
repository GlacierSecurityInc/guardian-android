    <style name="DialerDigit" parent="@android:style/TextAppearance.Medium">
        <item name="android:textColor">@android:color/transparent</item>
        <item name="android:layout_width">80dp</item>
        <item name="android:layout_height">80dp</item>
    </style>

    <!-- Direction B keypad: one cell of the 3-column grid, equal width, full height -->
    <style name="DialerKeyCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
    </style>

    <!-- Direction B keypad key visuals (digit + letter sub-label) -->
    <style name="DialerKeyLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:duplicateParentState">false</item>
    </style>

    <style name="DialerKeyDigit">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="DialerKeyLetters">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">14dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <declare-styleable name="Numpad">
        <attr name="play_dtmf">
            <enum name="dont" value="0" />
            <enum name="play" value="1" />
        </attr>
    </declare-styleable>

    <style name="numpad_composed_number_font" parent="@android:style/TextAppearance.Medium">
        <item name="android:textColor">?colorControlNormal</item>
        <item name="android:textSize">30sp</item>
    </style>



    <style name="ThemeOverlay.App.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/md_theme_surfaceContainerHigh</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_onSurfaceVariant</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.App.AlertDialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.App.AlertDialog.Button.Primary</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.App.AlertDialog.Button.Secondary</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.App.AlertDialog.Button.Secondary</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.AlertDialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="Widget.App.AlertDialog.Button.Primary" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/md_theme_primary</item>
    </style>

    <style name="Widget.App.AlertDialog.Button.Secondary" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/md_theme_onSurfaceVariant</item>
    </style>

</resources>
