<?xml version="1.0" encoding="utf-8"?>
<!-- Core Connection — modernized. A selectable profile row in the picker sheet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/cc_server_item_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <TextView
        android:id="@+id/server_item_code"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/cc_country_tile_bg"
        android:gravity="center"
        android:text=""
        android:textColor="@color/cc_text"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/server_item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/cc_text"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/server_item_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/cc_muted"
            android:textSize="12sp"
            android:visibility="gone" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/server_item_check"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/cc_check_badge_bg"
        android:visibility="gone">

        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_cc_check"
            app:tint="@color/cc_on_green" />

    </FrameLayout>

</LinearLayout>
