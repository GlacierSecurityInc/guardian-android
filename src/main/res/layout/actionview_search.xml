<?xml version="1.0" encoding="utf-8"?>
<!-- Modernized search field: a rounded pill with a leading magnifier and an
     inline × clear button, replacing the old underlined EditText. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="46dp"
    android:background="@drawable/bg_search_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="6dp">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_search_24dp"
        app:tint="?attr/colorOnSurfaceVariant" />

    <EditText
        android:id="@+id/search_field"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:background="@null"
        android:focusable="true"
        android:hint="@string/search_messages_contacts"
        android:imeOptions="flagNoExtractUi|actionSearch"
        android:inputType="textEmailAddress|textNoSuggestions"
        android:maxLines="1"
        android:paddingVertical="0dp"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="?attr/colorOnSurfaceVariant"
        android:textSize="15sp" />

    <ImageButton
        android:id="@+id/search_clear"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/search_clear_field"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_clear_24dp"
        android:visibility="gone"
        app:tint="?attr/colorOnSurfaceVariant" />

</LinearLayout>
