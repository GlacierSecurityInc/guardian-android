<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/foreign_keys_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/activity_horizontal_margin"
        android:layout_marginTop="@dimen/activity_vertical_margin"
        android:layout_marginRight="@dimen/activity_horizontal_margin"
        android:layout_marginBottom="@dimen/activity_vertical_margin"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/card_padding_regular">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/contact_avatar"
                    android:layout_width="@dimen/avatar"
                    android:layout_height="@dimen/avatar"
                    android:contentDescription="@string/contact_picture"
                    android:scaleType="centerCrop"
                    android:src="@drawable/baseline_person_24"
                    app:riv_corner_radius="@dimen/avatar"
                    app:riv_mutate_background="true" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/avatar_item_distance"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/foreign_keys_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textAppearance="?textAppearanceTitleMedium"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/foreign_keys_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:singleLine="true"
                        android:textAppearance="?textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <com.google.android.material.chip.Chip
                    android:id="@+id/foreign_keys_status_chip"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/list_padding"
                    android:checkable="false"
                    android:clickable="false"
                    android:focusable="false"
                    android:minHeight="36dp"
                    android:textAllCaps="false"
                    android:textAppearance="?textAppearanceLabelMedium"
                    android:textStyle="bold"
                    app:chipIconVisible="true"
                    app:chipMinHeight="36dp"
                    app:chipStrokeWidth="0dp"
                    app:ensureMinTouchTargetSize="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/foreign_keys_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"/>

<!--            <TextView-->
<!--                android:id="@+id/no_keys_to_accept"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_marginTop="@dimen/card_padding_small"-->
<!--                android:text="@string/no_keys_just_confirm"-->
<!--                android:textAppearance="?textAppearanceBodyMedium"-->
<!--                android:visibility="gone" />-->
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
