<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center">

    <ImageView
        android:id="@+id/voicemail_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_voicemail_24dp"
        android:adjustViewBounds="true"
        android:padding="4dp" />

    <ImageView
        android:id="@+id/voicemail_badge"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_alignEnd="@id/voicemail_icon"
        android:layout_alignTop="@id/voicemail_icon"
        android:src="@drawable/ic_red"
        android:visibility="gone" />

</RelativeLayout>
