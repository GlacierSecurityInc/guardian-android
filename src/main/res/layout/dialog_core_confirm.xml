<?xml version="1.0" encoding="utf-8"?>
<!--
  Core Connection — modernized. Shared confirmation dialog (connect / switch /
  disconnect / download / delete / import). Icon tile + title + optional
  subtitle, an optional message line, an optional summary-chip row, and
  Cancel / action buttons — matching the Rename-profile dialog's style.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/cc_dialog_bg"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/confirm_icon_tile"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/cc_icon_tile"
            android:backgroundTint="@color/cc_accent_soft">

            <ImageView
                android:id="@+id/confirm_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_cc_shield_check"
                app:tint="@color/cc_accent" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/confirm_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/cc_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/confirm_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/cc_muted"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/confirm_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingMultiplier="1.4"
        android:text=""
        android:textColor="@color/cc_muted"
        android:textSize="13.5sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/confirm_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirm_cancel"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cancel"
            android:textColor="@color/cc_text"
            app:strokeColor="@color/cc_border_strong" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirm_action"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1.3"
            android:backgroundTint="@color/cc_accent"
            android:text="@string/connect"
            android:textColor="@color/cc_accent_ink"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconTint="@color/cc_accent_ink" />

    </LinearLayout>

</LinearLayout>
