<?xml version="1.0" encoding="utf-8"?>
<!--
  Core Connection — modernized. Rename-profile dialog.
  Tag icon + title + profile id, a labelled field with an inline clear (×)
  button to quick-wipe the entry, and Cancel / Save actions. Save is disabled
  while the field is empty.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/cc_dialog_bg"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/cc_icon_tile_accent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_label_24dp"
                app:tint="@color/cc_accent" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/core_rename_profile_title"
                android:textColor="@color/cc_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rename_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/cc_muted"
                android:textSize="12.5sp" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp"
        android:letterSpacing="0.05"
        android:text="@string/core_profile_name_label"
        android:textAllCaps="true"
        android:textColor="@color/cc_dim"
        android:textSize="11sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/displayname_layout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxStrokeColor="@color/cc_accent"
        app:boxStrokeWidth="1.5dp"
        app:endIconMode="clear_text"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/displayname_et"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/core_profile_name_hint"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/cc_text" />

    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rename_cancel"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cancel"
            android:textColor="@color/cc_text"
            app:strokeColor="@color/cc_border_strong" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rename_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1.3"
            android:backgroundTint="@color/cc_accent"
            android:text="@string/save"
            android:textColor="@color/cc_accent_ink" />

    </LinearLayout>

</LinearLayout>
