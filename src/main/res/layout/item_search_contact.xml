<?xml version="1.0" encoding="utf-8"?>
<!-- A single contact result row in the modernized search screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_selectable_list_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="18dp"
    android:paddingVertical="9dp">

    <com.makeramen.roundedimageview.RoundedImageView
        android:id="@+id/contact_photo"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="centerCrop"
        android:src="@drawable/baseline_person_24"
        app:riv_corner_radius="13dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/contact_display_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15.5sp"
            android:textStyle="bold"
            android:fontFamily="@font/neue_haas_grotesk" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/contact_shield"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_cc_shield_check"
                android:visibility="gone"
                app:tint="@color/glacier_button" />

            <TextView
                android:id="@+id/contact_jid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/contact_message"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_search_action_btn"
        android:contentDescription="@string/search_message_contact"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_chat_24dp"
        app:tint="@color/glacier_button" />

</LinearLayout>
