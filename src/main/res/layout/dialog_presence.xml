<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="false">
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.appbar.MaterialToolbar style="@style/BlackToolbar"
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/actionBarSize" />

        </com.google.android.material.appbar.AppBarLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <!-- ── Manual section ─────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="14dp"
                android:paddingBottom="4dp"
                android:text="@string/presence_manual_group"
                android:textAllCaps="true"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:fontFamily="@font/neue_haas_grotesk"
                android:textColor="?android:attr/textColorSecondary"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/show"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:paddingBottom="6dp">

                <RadioButton
                    android:id="@+id/online"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="@string/presence_online" />

                <RadioButton
                    android:id="@+id/away"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="@string/presence_away" />

                <RadioButton
                    android:id="@+id/dnd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="@string/presence_dnd" />

                <RadioButton
                    android:id="@+id/xa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="@string/presence_xa" />

            </RadioGroup>

            <!-- ── Managed section ────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="6dp"
                android:paddingBottom="4dp"
                android:text="@string/presence_managed_group"
                android:textAllCaps="true"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:fontFamily="@font/neue_haas_grotesk"
                android:textColor="?android:attr/textColorSecondary"
                android:textStyle="bold" />

            <!-- Managed row: RadioGroup (single item) + inline edit button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="2dp"
                android:paddingBottom="10dp">

                <RadioGroup
                    android:id="@+id/managed_show"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <RadioButton
                        android:id="@+id/device_managed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:text="@string/device_managed_status" />

                </RadioGroup>

                <ImageButton
                    android:id="@+id/edit_availability_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_edit_24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@string/edit_availability_settings" />

            </LinearLayout>

            <View
                android:id="@+id/divider2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/listDivider"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="8dp"/>

            <!-- ── Status Messages section ───────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="6dp"
                android:paddingBottom="4dp"
                android:text="@string/presence_status_messages_group"
                android:textAllCaps="true"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:fontFamily="@font/neue_haas_grotesk"
                android:textColor="?android:attr/textColorSecondary"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/statuses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp">

                <RadioButton
                    android:id="@+id/in_meeting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:text="@string/in_meeting"/>

                <RadioButton
                    android:id="@+id/on_travel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:text="@string/on_travel" />

                <RadioButton
                    android:id="@+id/out_sick"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:text="@string/out_sick" />

                <RadioButton
                    android:id="@+id/vacation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:text="@string/vacation" />

                <RadioButton
                    android:id="@+id/custom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:text="@string/custom" />

            </RadioGroup>

            <!-- Custom status message text field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/status_message_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="4dp">

                <com.glaciersecurity.glaciermessenger.ui.widget.ImmediateAutoCompleteTextView
                    android:padding="16dp"
                    android:id="@+id/status_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:hint="@string/status_message"
                    android:imeOptions="actionDone"
                    android:inputType="textShortMessage" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
        </ScrollView>

        <!-- Clear and Confirm buttons — sticky footer, always visible above keyboard -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clear_prefs"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clear_status" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirm_button"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/confirm" />

        </LinearLayout>

    </LinearLayout>
</layout>
