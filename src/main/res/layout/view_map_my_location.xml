<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <!-- "You" tag -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_you_tag_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="@string/self_marker_you_label"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginTop="-4dp"
            android:background="#3B82F6"
            android:rotation="45" />

    </LinearLayout>

    <!-- Accuracy halo + white casing + blue dot -->
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="2dp">

        <View
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_self_marker_halo" />

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:elevation="4dp"
            android:src="@drawable/baseline_circle_24"
            app:tint="@android:color/white"
            android:contentDescription="@null" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:elevation="5dp"
            android:src="@drawable/baseline_circle_24"
            app:tint="#3B82F6"
            android:contentDescription="@string/content_description_my_location" />

    </FrameLayout>

</LinearLayout>
