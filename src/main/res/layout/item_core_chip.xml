<?xml version="1.0" encoding="utf-8"?>
<!-- Core Connection — modernized. Summary chip used in the connect dialog. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/cc_chip_bg"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/chip_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.05"
        android:text=""
        android:textAllCaps="true"
        android:textColor="@color/cc_dim"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/chip_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textColor="@color/cc_text"
        android:textSize="12.5sp"
        android:textStyle="bold" />

</LinearLayout>
