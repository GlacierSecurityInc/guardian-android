<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/restore_bg"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/restore_bg">

            <com.google.android.material.appbar.MaterialToolbar style="@style/BlackToolbar"
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/restore_bg"
                android:minHeight="?attr/actionBarSize" />
        </com.google.android.material.appbar.AppBarLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/app_bar_layout"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="14dp"
                android:paddingBottom="26dp">

                <!-- ── Form page ─────────────────────────────────────────────── -->
                <LinearLayout
                    android:id="@+id/reset_form_page"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="22dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_reset_icon_tile">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                app:srcCompat="@drawable/baseline_vpn_key_24"
                                app:tint="@color/restore_accent" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/neue_haas_grotesk"
                                android:text="@string/reset_password_title"
                                android:textColor="@color/restore_text"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:fontFamily="@font/neue_haas_grotesk"
                                android:lineSpacingMultiplier="1.2"
                                android:text="@string/reset_password_subtitle"
                                android:textColor="@color/restore_muted"
                                android:textSize="13.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- New password -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="@font/neue_haas_grotesk"
                        android:text="@string/new_password_label"
                        android:textColor="@color/restore_muted"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/reset_new_password_field"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_reset_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="4dp">

                        <ImageView
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:contentDescription="@null"
                            app:srcCompat="@drawable/ic_lock_outline_24dp"
                            app:tint="@color/restore_muted" />

                        <EditText
                            android:id="@+id/reset_new_password_input"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="11dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:fontFamily="@font/neue_haas_grotesk"
                            android:hint="@string/new_password_placeholder"
                            android:imeOptions="actionNext"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:textColor="@color/restore_text"
                            android:textSize="15.5sp" />

                        <ImageView
                            android:id="@+id/reset_new_password_toggle"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="@null"
                            android:focusable="true"
                            android:padding="9dp"
                            app:srcCompat="@drawable/ic_visibility_off"
                            app:tint="@color/restore_muted" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/reset_strength_segment_1"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_reset_strength_segment" />

                        <View
                            android:id="@+id/reset_strength_segment_2"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_reset_strength_segment" />

                        <View
                            android:id="@+id/reset_strength_segment_3"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_reset_strength_segment" />

                        <View
                            android:id="@+id/reset_strength_segment_4"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_reset_strength_segment" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/reset_strength_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:fontFamily="@font/neue_haas_grotesk"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- Requirements checklist (2-column grid) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:id="@+id/reset_req_length_dot"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:background="@drawable/bg_reset_requirement_dot_unmet">

                                <ImageView
                                    android:id="@+id/reset_req_length_check"
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:visibility="gone"
                                    app:srcCompat="@drawable/ic_check_24dp"
                                    app:tint="@color/reset_strength_strong" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/reset_req_length_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/neue_haas_grotesk"
                                android:text="@string/password_requirement_length"
                                android:textColor="@color/restore_muted"
                                android:textSize="12.5sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:id="@+id/reset_req_case_dot"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:background="@drawable/bg_reset_requirement_dot_unmet">

                                <ImageView
                                    android:id="@+id/reset_req_case_check"
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:visibility="gone"
                                    app:srcCompat="@drawable/ic_check_24dp"
                                    app:tint="@color/reset_strength_strong" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/reset_req_case_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/neue_haas_grotesk"
                                android:text="@string/password_requirement_case"
                                android:textColor="@color/restore_muted"
                                android:textSize="12.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:id="@+id/reset_req_number_dot"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:background="@drawable/bg_reset_requirement_dot_unmet">

                                <ImageView
                                    android:id="@+id/reset_req_number_check"
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:visibility="gone"
                                    app:srcCompat="@drawable/ic_check_24dp"
                                    app:tint="@color/reset_strength_strong" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/reset_req_number_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/neue_haas_grotesk"
                                android:text="@string/password_requirement_number"
                                android:textColor="@color/restore_muted"
                                android:textSize="12.5sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:id="@+id/reset_req_symbol_dot"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:background="@drawable/bg_reset_requirement_dot_unmet">

                                <ImageView
                                    android:id="@+id/reset_req_symbol_check"
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:visibility="gone"
                                    app:srcCompat="@drawable/ic_check_24dp"
                                    app:tint="@color/reset_strength_strong" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/reset_req_symbol_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/neue_haas_grotesk"
                                android:text="@string/password_requirement_symbol"
                                android:textColor="@color/restore_muted"
                                android:textSize="12.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Confirm new password -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="@font/neue_haas_grotesk"
                        android:text="@string/repeat_new_password_label"
                        android:textColor="@color/restore_muted"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/reset_repeat_password_field"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_reset_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="4dp">

                        <ImageView
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:contentDescription="@null"
                            app:srcCompat="@drawable/ic_lock_outline_24dp"
                            app:tint="@color/restore_muted" />

                        <EditText
                            android:id="@+id/reset_repeat_password_input"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="11dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:fontFamily="@font/neue_haas_grotesk"
                            android:hint="@string/repeat_new_password_placeholder"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:textColor="@color/restore_text"
                            android:textSize="15.5sp" />

                        <ImageView
                            android:id="@+id/reset_repeat_password_toggle"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="@null"
                            android:focusable="true"
                            android:padding="9dp"
                            app:srcCompat="@drawable/ic_visibility_off"
                            app:tint="@color/restore_muted" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/reset_confirm_status_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/reset_confirm_status_icon"
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/reset_confirm_status_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/neue_haas_grotesk"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/reset_error_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            app:srcCompat="@drawable/ic_error_24dp"
                            app:tint="@color/reset_strength_weak" />

                        <TextView
                            android:id="@+id/reset_error_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/neue_haas_grotesk"
                            android:textColor="@color/reset_strength_weak"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="24dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/reset_submit_button"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_reset_btn_primary"
                            android:enabled="false"
                            android:fontFamily="@font/neue_haas_grotesk"
                            android:gravity="center"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/update_password_button"
                            android:textAllCaps="false"
                            android:textColor="@color/text_btn_reset_primary_v2"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:icon="@drawable/ic_cc_shield_check"
                            app:iconGravity="textStart"
                            app:iconPadding="9dp"
                            app:iconTint="@color/text_btn_reset_primary_v2" />

                        <ProgressBar
                            android:id="@+id/reset_progress_bar"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:indeterminate="true"
                            android:indeterminateTint="@android:color/white"
                            android:visibility="gone" />
                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/reset_cancel_button"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/neue_haas_grotesk"
                        android:text="@string/cancel"
                        android:textAllCaps="false"
                        android:textColor="@color/restore_muted"
                        android:textSize="14.5sp" />
                </LinearLayout>

                <!-- ── Success page ─────────────────────────────────────────── -->
                <LinearLayout
                    android:id="@+id/reset_success_page"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="48dp"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:layout_marginBottom="20dp"
                        android:background="@drawable/bg_reset_success_badge_outer">

                        <FrameLayout
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_reset_success_badge_inner">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                app:srcCompat="@drawable/ic_check_24dp"
                                app:tint="@android:color/white" />
                        </FrameLayout>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/neue_haas_grotesk"
                        android:text="@string/password_updated_title"
                        android:textColor="@color/restore_text"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/neue_haas_grotesk"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.3"
                        android:maxWidth="300dp"
                        android:text="@string/password_updated_subtitle"
                        android:textColor="@color/restore_muted"
                        android:textSize="14sp" />

                    <ProgressBar
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginTop="18dp"
                        android:importantForAccessibility="no"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/restore_accent" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </RelativeLayout>
</layout>
