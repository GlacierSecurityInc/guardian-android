<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="vertical">


    <RelativeLayout
        android:id="@+id/history_whole"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_margin="5dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/detail"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:adjustViewBounds="true"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:src="@drawable/list_detail"
            android:visibility="gone"/>

        <CheckBox
            android:id="@+id/delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerInParent="true"
            android:button="@drawable/checkbox"
            android:clickable="false"
            android:padding="5dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/hist_call_time"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_toLeftOf="@+id/detail"
            android:layout_alignParentRight="true"

            android:layout_alignParentTop="true"
            android:layout_marginRight="10dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:lines="1"
            android:maxLines="1"
            android:textColor="?attr/colorControlNormal"
            android:textSize="13sp"
            />


        <TextView
            android:id="@+id/hist_direction"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_toLeftOf="@+id/hist_call_time"
            android:layout_alignParentTop="true"
            android:layout_marginRight="10dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:lines="1"
            android:maxLines="1"
            android:textColor="?attr/colorControlNormal"
            android:textSize="13sp"
            android:visibility="gone"/>

        <RelativeLayout
            android:id="@+id/history_click"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toLeftOf="@id/detail"
            android:gravity="center_vertical">

            <!--            <RelativeLayout-->
            <!--                android:id="@+id/avatar"-->
            <!--                android:layout_width="wrap_content"-->
            <!--                android:layout_height="match_parent"-->
            <!--                android:gravity="center">-->

            <!--                <include layout="@layout/contact_avatar" />-->

            <!--            </RelativeLayout>-->

            <ImageView
                android:id="@+id/icon"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginLeft="5dp"
                android:adjustViewBounds="true"
                android:padding="7dp" />

            <TextView
                android:id="@+id/hist_status"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:textColor="?attr/colorControlNormal"
                app:fontFamily="@font/neue_haas_grotesk"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="10dp"
                android:layout_toRightOf="@id/icon"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:visibility="gone"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/hist_duration"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:textColor="?attr/colorControlNormal"
                app:fontFamily="@font/neue_haas_grotesk"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="20dp"
                android:layout_toRightOf="@id/icon"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:textStyle="bold" />

        </RelativeLayout>

    </RelativeLayout>

</LinearLayout>