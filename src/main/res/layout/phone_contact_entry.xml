<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:paddingStart="24dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/respond_to_contact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/start_sms_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_quick_action_outline"
            android:contentDescription="@string/message"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/baseline_sms_24"
            app:tint="?attr/colorPrimary" />

        <ImageView
            android:id="@+id/start_call_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_quick_action_filled"
            android:contentDescription="@string/call"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/baseline_local_phone_24"
            app:tint="?attr/colorPrimary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="12dp"
        android:layout_toStartOf="@id/respond_to_contact"
        android:orientation="vertical">

        <TextView
            android:id="@+id/phone_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/neue_haas_grotesk"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            tools:text="+1 (415) 555-0117"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/phone_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12.5sp"
            tools:text="Mobile" />
    </LinearLayout>

</RelativeLayout>
