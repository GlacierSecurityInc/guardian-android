<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="@dimen/footerBarSize">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.appbar.MaterialToolbar style="@style/BlackToolbar"
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/actionBarSize" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/app_bar_layout"
                app:tabGravity="fill"
                app:tabMode="fixed" />


        </com.google.android.material.appbar.AppBarLayout>

        <include
            android:id="@+id/offline_layout"
            layout="@layout/toolbar_connection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/app_bar_layout"
            android:visibility="gone" />

        <include  android:id="@+id/return_to_external_call"
            layout="@layout/external_call"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:visibility="gone" />

        <include  android:id="@+id/return_to_glacier_call"
            layout="@layout/glacier_call"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:visibility="gone" />


        <androidx.viewpager.widget.ViewPager
            android:id="@+id/start_conversation_view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/offline_layout">


        </androidx.viewpager.widget.ViewPager>

        <com.leinardi.android.speeddial.SpeedDialOverlayLayout
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/offline_layout" />


        <com.leinardi.android.speeddial.SpeedDialView
            android:id="@+id/speed_dial"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:contentDescription="@string/attach_file"
            app:sdMainFabClosedSrc="@drawable/ic_add_24dp"
            app:sdMainFabClosedBackgroundColor="@color/glacier_blue"
            app:sdMainFabClosedIconColor="@android:color/white"
            app:sdMainFabOpenedBackgroundColor="@color/glacier_blue"
            app:sdMainFabOpenedIconColor="@android:color/white"
            app:sdOverlayLayout="@id/overlay"
            app:sdUseReverseAnimationOnClose="true" />
    </RelativeLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navigation_conversations"
        android:transitionName="bottomNav"
        style="@style/BlackBottomNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/footerBarSize"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom"
        app:itemIconTint="@color/color_state_light"
        app:itemTextColor="@color/color_state_light"
        app:menu="@menu/menu_bottom_navigation_conversations" />
</RelativeLayout>
</layout>
