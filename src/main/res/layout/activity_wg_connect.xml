<?xml version="1.0" encoding="utf-8"?>
<!--
  Core Connection — modernized.

  Neutral app bar (state lives in the orb + status pill, not a coloured bar),
  a glowing power orb that toggles the tunnel, a live session card with a
  throughput sparkline when connected, a tappable server-selector card that
  opens a bottom sheet, an icon-led action row, and a protection assurance
  strip. Import + Settings moved into the toolbar as icon actions.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cc_bg"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.appbar.AppBarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/cc_bg"
                app:elevation="0dp">

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/toolbar"
                    style="@style/BlackToolbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/cc_bg"
                    android:minHeight="?attr/actionBarSize" />

            </com.google.android.material.appbar.AppBarLayout>

            <include
                android:id="@+id/offline_layout"
                layout="@layout/toolbar_connection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <ProgressBar
                android:id="@+id/topProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <include
                android:id="@+id/return_to_external_call"
                layout="@layout/external_call"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <include
                android:id="@+id/return_to_glacier_call"
                layout="@layout/glacier_call"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingBottom="14dp">

                    <!-- Hero: orb + status label + status pill -->
                    <LinearLayout
                        android:id="@+id/core_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingTop="20dp"
                        android:paddingBottom="4dp">

                        <FrameLayout
                            android:id="@+id/connection_status_indicator"
                            android:layout_width="188dp"
                            android:layout_height="188dp"
                            android:layout_gravity="center"
                            android:clickable="true"
                            android:focusable="true">

                            <com.glaciersecurity.glaciermessenger.ui.widget.ConnectionOrbView
                                android:id="@+id/connection_orb"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <ImageView
                                android:id="@+id/connection_icon"
                                android:layout_width="58dp"
                                android:layout_height="58dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/core_toggle_description"
                                android:src="@drawable/ic_cc_power"
                                app:tint="@color/cc_muted" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/connection_status_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:letterSpacing="-0.02"
                            android:text="@string/core_status_disconnected"
                            android:textColor="@color/cc_text"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/status_pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/cc_status_pill_off"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="6dp">

                            <TextView
                                android:id="@+id/status_pill_code"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/cc_cc_chip_bg"
                                android:backgroundTint="@color/cc_border_strong"
                                android:gravity="center"
                                android:text=""
                                android:textColor="@color/cc_muted"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/location_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:maxWidth="240dp"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:text="@string/core_no_active_profile"
                                android:textColor="@color/cc_muted"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Live session card (connected only) -->
                    <LinearLayout
                        android:id="@+id/session_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/cc_card_bg"
                        android:orientation="vertical"
                        android:paddingHorizontal="18dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="14dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:letterSpacing="0.06"
                                    android:text="@string/core_session_label"
                                    android:textAllCaps="true"
                                    android:textColor="@color/cc_muted"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/session_duration"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:fontFeatureSettings="tnum"
                                    android:text="00:00:00"
                                    android:textColor="@color/cc_text"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:letterSpacing="0.06"
                                    android:text="@string/core_down_label"
                                    android:textAllCaps="true"
                                    android:textColor="@color/cc_green"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/session_down"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:fontFeatureSettings="tnum"
                                    android:text="@string/core_stat_unavailable"
                                    android:textColor="@color/cc_text"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:letterSpacing="0.06"
                                    android:text="@string/core_up_label"
                                    android:textAllCaps="true"
                                    android:textColor="@color/cc_accent"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/session_up"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:fontFeatureSettings="tnum"
                                    android:text="@string/core_stat_unavailable"
                                    android:textColor="@color/cc_text"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="14dp">

                            <com.glaciersecurity.glaciermessenger.ui.widget.ThroughputSparklineView
                                android:id="@+id/sparkline"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|end"
                                android:gravity="bottom"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/session_rate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFeatureSettings="tnum"
                                    android:text="0.0"
                                    android:textColor="@color/cc_text"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/session_rate_unit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="@string/core_throughput_unit"
                                    android:textColor="@color/cc_muted"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </FrameLayout>

                    </LinearLayout>

                    <!-- Protection prose card (disconnected only) -->
                    <LinearLayout
                        android:id="@+id/prose_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/cc_card_bg"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="12dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_cc_shield_check"
                            app:tint="@color/cc_muted" />

                        <TextView
                            android:id="@+id/core_link"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingMultiplier="1.4"
                            android:text="@string/enable_core_connection"
                            android:textColor="@color/cc_muted"
                            android:textColorLink="@color/cc_accent"
                            android:textSize="13.5sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/connection_status_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/core_status_connected_subtitle"
                        android:textColor="@color/cc_muted"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/external_vpn_warning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/external_vpn_active"
                        android:textColor="@color/md_theme_error"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <!-- Server selector card -->
                    <LinearLayout
                        android:id="@+id/server_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/cc_server_card_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:id="@+id/server_card_code"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/cc_country_tile_bg"
                            android:gravity="center"
                            android:text=""
                            android:textColor="@color/cc_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.06"
                                android:text="@string/core_active_profile_label"
                                android:textAllCaps="true"
                                android:textColor="@color/cc_dim"
                                android:textSize="10.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/server_card_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="@string/core_profile_spinner_hint"
                                android:textColor="@color/cc_text"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="4dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_cc_chevron_down"
                            app:tint="@color/cc_muted" />

                    </LinearLayout>

                    <!-- Icon-led action row -->
                    <LinearLayout
                        android:id="@+id/selected_profile_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/button_rename_profile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/cc_action_button_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="12dp">

                            <ImageView
                                android:layout_width="19dp"
                                android:layout_height="19dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_label_24dp"
                                app:tint="@color/cc_accent" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/nickname"
                                android:textColor="@color/cc_text"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/button_download_profile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/cc_action_button_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="12dp">

                            <ImageView
                                android:layout_width="19dp"
                                android:layout_height="19dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_download_24dp"
                                app:tint="@color/cc_accent" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/download"
                                android:textColor="@color/cc_text"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/button_delete_profile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/cc_action_button_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="12dp">

                            <ImageView
                                android:layout_width="19dp"
                                android:layout_height="19dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_delete_24dp"
                                app:tint="@color/cc_danger" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/delete"
                                android:textColor="@color/cc_danger"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- Protection assurance strip -->
                    <LinearLayout
                        android:id="@+id/protection_strip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/protection_strip_icon"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_lock_24dp"
                            app:tint="@color/cc_dim" />

                        <TextView
                            android:id="@+id/protection_strip_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/core_protection_strip"
                            android:textColor="@color/cc_dim"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </LinearLayout>

    </RelativeLayout>

</layout>
