<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                style="@style/BlackToolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/actionBarSize" />

        </com.google.android.material.appbar.AppBarLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/app_bar_layout"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/login_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:paddingTop="28dp"
                android:paddingBottom="24dp">

                <!-- Brand: glacier blue on light, white on dark (tinted vector) -->
                <ImageView
                    android:id="@+id/icon"
                    android:layout_width="92dp"
                    android:layout_height="92dp"
                    android:layout_gravity="center_horizontal"
                    android:padding="6dp"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/ic_glacier_brand" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/neue_haas_grotesk"
                    android:text="@string/welcome_back"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/neue_haas_grotesk"
                    android:text="@string/sign_in_subtitle"
                    android:textColor="?attr/colorControlNormal"
                    android:textSize="14sp" />

                <!-- Username -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/account_username_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:hint="@string/account_settings_user_name"
                    app:boxBackgroundColor="@color/login_field_fill"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/glacier_blue"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:helperText="@string/login_field_helper_spacer"
                    app:helperTextEnabled="true"
                    app:startIconDrawable="@drawable/ic_person_outline_24dp"
                    app:startIconTint="?attr/colorControlNormal">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/account_username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/neue_haas_grotesk"
                        android:imeOptions="actionNext"
                        android:padding="16dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/account_password_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/password"
                    app:boxBackgroundColor="@color/login_field_fill"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/glacier_blue"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:endIconMode="password_toggle"
                    app:endIconTint="?attr/colorControlNormal"
                    app:helperText="@string/login_field_helper_spacer"
                    app:helperTextEnabled="true"
                    app:startIconDrawable="@drawable/ic_lock_outline_24dp"
                    app:startIconTint="?attr/colorControlNormal">

                    <com.glaciersecurity.glaciermessenger.ui.widget.MeizuTextInputEditText
                        android:id="@+id/account_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/neue_haas_grotesk"
                        android:inputType="textPassword"
                        android:padding="16dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/forgot_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/neue_haas_grotesk"
                    android:onClick="forgotPassword"
                    android:padding="4dp"
                    android:text="@string/forgot_password"
                    android:textColor="@color/cc_accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Primary CTA: the progress spinner lives inside the button -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="20dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/account_login"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:enabled="false"
                        android:background="@drawable/bg_btn_primary"
                        android:backgroundTint="@null"
                        app:backgroundTint="@null"
                        android:fontFamily="@font/neue_haas_grotesk"
                        android:gravity="center"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/login"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_lock_24dp"
                        app:iconGravity="textStart"
                        app:iconPadding="9dp"
                        app:iconTint="@android:color/white" />

                    <ProgressBar
                        android:id="@+id/progress_bar"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:indeterminate="true"
                        android:indeterminateTint="@android:color/white"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- Restore account -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/import_account"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_btn_secondary_outline"
                    android:fontFamily="@font/neue_haas_grotesk"
                    android:gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:onClick="importAccount"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/restore_account"
                    android:textAllCaps="false"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_baseline_history_24"
                    app:iconGravity="textStart"
                    app:iconPadding="9dp"
                    app:iconTint="@color/glacier_blue" />

                <!-- Push the footer to the bottom of the viewport -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />




                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:alpha="0.6"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/login_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/neue_haas_grotesk"
                        android:textColor="?attr/colorControlNormal"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </RelativeLayout>
</layout>
