<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/restore_bg"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/restore_bg">

            <com.google.android.material.appbar.MaterialToolbar style="@style/BlackToolbar"
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/restore_bg"
                android:minHeight="?attr/actionBarSize" />
        </com.google.android.material.appbar.AppBarLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/app_bar_layout"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:paddingTop="14dp"
                android:paddingBottom="26dp">

                <!-- ── Form page ─────────────────────────────────────────────── -->
                <LinearLayout
                    android:id="@+id/mfa_form_page"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Centered header -->
                    <FrameLayout
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_mfa_badge">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            app:srcCompat="@drawable/ic_cc_shield_check"
                            app:tint="@color/restore_accent" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:fontFamily="@font/neue_haas_grotesk"
                        android:gravity="center"
                        android:text="@string/mfa_verification_title"
                        android:textColor="@color/restore_text"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/neue_haas_grotesk"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.35"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="@string/mfa_sheet_subtitle"
                        android:textColor="@color/restore_muted"
                        android:textSize="13.5sp" />

                    <!-- Segmented six-digit code entry. The boxes are built at
                         runtime inside mfa_otp_container; the transparent
                         EditText overlaps them to capture keystrokes, paste and
                         taps while staying invisible. -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp">

                        <LinearLayout
                            android:id="@+id/mfa_otp_container"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:orientation="horizontal" />

                        <EditText
                            android:id="@+id/mfa_code_input"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:background="@null"
                            android:cursorVisible="false"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="6"
                            android:maxLines="1"
                            android:textColor="@android:color/transparent"
                            android:textCursorDrawable="@null"
                            android:textIsSelectable="false" />
                    </FrameLayout>

                    <!-- Paste from clipboard -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mfa_paste_button"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/neue_haas_grotesk"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/mfa_paste_button"
                        android:textAllCaps="false"
                        android:textColor="@color/restore_accent"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        app:icon="@drawable/baseline_content_copy_24"
                        app:iconGravity="textStart"
                        app:iconPadding="7dp"
                        app:iconSize="16dp"
                        app:iconTint="@color/restore_accent" />

                    <LinearLayout
                        android:id="@+id/mfa_error_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            app:srcCompat="@drawable/ic_error_24dp"
                            app:tint="@color/reset_strength_weak" />

                        <TextView
                            android:id="@+id/mfa_error_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/neue_haas_grotesk"
                            android:textColor="@color/reset_strength_weak"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="22dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/mfa_confirm_button"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_reset_btn_primary"
                            android:enabled="false"
                            android:fontFamily="@font/neue_haas_grotesk"
                            android:gravity="center"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/mfa_confirm_button"
                            android:textAllCaps="false"
                            android:textColor="@color/text_btn_reset_primary_v2"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:icon="@drawable/ic_cc_shield_check"
                            app:iconGravity="textStart"
                            app:iconPadding="9dp"
                            app:iconTint="@color/text_btn_reset_primary_v2" />

                        <ProgressBar
                            android:id="@+id/mfa_progress_bar"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:indeterminate="true"
                            android:indeterminateTint="@android:color/white"
                            android:visibility="gone" />
                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mfa_cancel_button"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/neue_haas_grotesk"
                        android:text="@string/cancel"
                        android:textAllCaps="false"
                        android:textColor="@color/restore_muted"
                        android:textSize="14.5sp" />

                    <!-- Lost-access escape hatch -->
                    <LinearLayout
                        android:id="@+id/mfa_lost_access"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp">

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:contentDescription="@null"
                            app:srcCompat="@drawable/ic_help_24dp"
                            app:tint="@color/restore_dim" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/neue_haas_grotesk"
                            android:text="@string/mfa_lost_access"
                            android:textColor="@color/restore_dim"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ── Success page ─────────────────────────────────────────── -->
                <LinearLayout
                    android:id="@+id/mfa_success_page"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="48dp"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:layout_marginBottom="20dp"
                        android:background="@drawable/bg_reset_success_badge_outer">

                        <FrameLayout
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_reset_success_badge_inner">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                app:srcCompat="@drawable/ic_check_24dp"
                                app:tint="@android:color/white" />
                        </FrameLayout>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/neue_haas_grotesk"
                        android:text="@string/mfa_verified_title"
                        android:textColor="@color/restore_text"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/neue_haas_grotesk"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.3"
                        android:maxWidth="300dp"
                        android:text="@string/mfa_verified_subtitle"
                        android:textColor="@color/restore_muted"
                        android:textSize="14sp" />

                    <ProgressBar
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginTop="18dp"
                        android:importantForAccessibility="no"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/restore_accent" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </RelativeLayout>
</layout>
