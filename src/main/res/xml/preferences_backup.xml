<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ListPreference
        android:defaultValue="@integer/automatic_message_deletion"
        android:icon="@drawable/ic_calendar_month_24dp"
        android:key="recurring_backup"
        android:order="10"
        android:title="@string/pref_backup_recurring"
        app:isPreferenceVisible="false"/>

    <Preference
        android:icon="@drawable/file_save_24px"
        android:key="local_backup"
        android:order="30"
        android:summary="@string/export_account_local_caption"
        android:title="@string/export_account_local" />

    <Preference
        android:icon="@drawable/baseline_folder_open_24"
        android:key="backup_location"
        android:order="40"
        android:summary="@string/pref_create_backup_summary"
        android:title="@string/pref_backup_location"
        android:selectable="false"
        />

</PreferenceScreen>
