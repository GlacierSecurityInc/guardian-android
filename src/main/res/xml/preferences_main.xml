<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <PreferenceScreen
        android:icon="@drawable/ic_new_releases_24dp"
        android:title="@string/whatsnew_button_key"
        android:key="@string/whatsnew_button_key"
        android:summary="@string/whatsnew_button_summary"
        >
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://glacier.chat/support" />
    </PreferenceScreen>

    <Preference
        android:icon="@drawable/ic_security_24dp"
        app:fragment="com.glaciersecurity.glaciermessenger.ui.fragment.settings.SecuritySettingsFragment"
        app:summary="@string/pref_summary_security"
        app:title="@string/pref_title_security"
        app:isPreferenceVisible="false"/>
    <Preference
        app:isPreferenceVisible="false"
        android:icon="@drawable/ic_phone_24dp"
        android:key="phone_setting"
        app:fragment="com.glaciersecurity.glaciermessenger.ui.fragment.settings.PhoneSettingsFragment"
        app:summary="@string/pref_phone_summary"
        app:title="@string/pref_title_phone" />
    <Preference
        app:isPreferenceVisible="false"
        android:icon="@drawable/ic_location_pin_24dp"
        android:key="mapping_setting"
        app:fragment="com.glaciersecurity.glaciermessenger.ui.fragment.settings.MappingSettingsFragment"
        app:summary="@string/mapping_description_pref"
        app:title="@string/pref_title_mapping" />
    <Preference
        android:icon="@drawable/ic_privacy_tip_24dp"
        app:fragment="com.glaciersecurity.glaciermessenger.ui.fragment.settings.PrivacySettingsFragment"
        app:summary="@string/pref_privacy_summary"
        app:title="@string/pref_privacy" />
    <Preference
        android:icon="@drawable/ic_notifications_24dp"
        android:summary="@string/pref_notifications_summary"
        android:title="@string/notifications"
        app:fragment="com.glaciersecurity.glaciermessenger.ui.fragment.settings.NotificationsSettingsFragment" />

    <Preference
        android:icon="@drawable/ic_touch_app_24dp"
        app:fragment="com.glaciersecurity.glaciermessenger.ui.fragment.settings.InterfaceSettingsFragment"
        app:summary="@string/pref_summary_appearance"
        app:title="@string/pref_title_interface" />

    <Preference
        android:icon="@drawable/ic_attachment_24dp"
        android:summary="@string/pref_attachments_summary"
        android:title="@string/pref_attachments"
        app:fragment="com.glaciersecurity.glaciermessenger.ui.fragment.settings.AttachmentsSettingsFragment" />
    <Preference
        android:icon="@drawable/ic_settings_ethernet_24dp"
        android:key="connection"
        app:fragment="com.glaciersecurity.glaciermessenger.ui.fragment.settings.ConnectionSettingsFragment"
        app:summary="@string/pref_connection_summary_w_cd"
        app:title="@string/pref_connection_options"
        app:isPreferenceVisible="false"/>
    <Preference
        android:icon="@drawable/ic_archive_24dp"
        android:key="backup"
        android:summary="@string/pref_backup_summary"
        android:title="@string/backup"
        app:fragment="com.glaciersecurity.glaciermessenger.ui.fragment.settings.BackupSettingsFragment" />
<!--    <Preference-->
<!--        android:icon="@drawable/ic_cloud_sync_24dp"-->
<!--        android:key="up"-->
<!--        app:fragment="com.glaciersecurity.glaciermessenger.ui.fragment.settings.UpSettingsFragment"-->
<!--        app:summary="@string/unified_push_summary"-->
<!--        app:title="@string/unified_push_distributor"-->
<!--        app:isPreferenceVisible="false"/>-->
    <Preference
        android:icon="@drawable/ic_gchat_24"
        android:key="about"
        android:title="@string/title_activity_about_x">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.glaciersecurity.glaciermessenger.ui.AboutActivity"
            android:targetPackage="@string/applicationId" />
    </Preference>
    <Preference android:title="@string/logout_button_key"
        android:icon="@drawable/ic_logout_24dp"
        android:key="logout_key"
        android:summary="@string/logout_button_summary"/>

</PreferenceScreen>