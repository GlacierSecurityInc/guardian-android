<?xml version="1.0" encoding="utf-8"?>
<!-- Reset-password sheet's primary CTA: a fully-rounded pill that visibly
     greys out while disabled (unmet requirements / unsubmittable form),
     unlike bg_btn_primary which has no disabled state. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="@color/login_field_fill" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="@color/blue_gray_650" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="@color/glacier_blue" />
        </shape>
    </item>
</selector>
