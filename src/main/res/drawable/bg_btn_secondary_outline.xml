<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary action (Restore Account): understated glacier-tinted outline
     over a very faint fill, matching the reference design while staying
     clearly visible against both light and dark backgrounds. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <solid android:color="#243C5CCF" />
            <stroke android:width="1.5dp" android:color="#883C5CCF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <solid android:color="#0D3C5CCF" />
            <stroke android:width="1.5dp" android:color="#663C5CCF" />
        </shape>
    </item>
</selector>
