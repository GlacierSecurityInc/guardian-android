<?xml version="1.0" encoding="utf-8"?>
<!-- Reset/MFA sheet primary CTA: rounded-rect pill that visibly greys out
     while disabled (unmet requirements / unsubmittable form). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <solid android:color="@color/restore_surface" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <solid android:color="@color/restore_accent_solid" />
        </shape>
    </item>
</selector>
