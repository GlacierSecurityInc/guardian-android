<?xml version="1.0" encoding="utf-8"?>
<!-- iOS-style fade: content scrolling toward the translucent bottom toolbar
     dissolves into the surface color instead of clipping abruptly under it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="90"
        android:startColor="?attr/colorSurface"
        android:endColor="@android:color/transparent" />
</shape>
